# MongoDB — lokal (Docker) oder Atlas
# Lokal:  mongodb://localhost:27017
# Atlas:  mongodb+srv://user:password@cluster.mongodb.net/windroute
MONGODB_URI=mongodb://localhost:27017

GRAPHHOPPER_API_KEY=your_graphhopper_api_key_here

# --- Authentifizierung ---
# Kein separates Session-Secret nötig — Tokens werden kryptografisch
# zufällig mit node:crypto generiert (32 Byte, base64url).
# Cookie-Name und Session-Dauer sind in src/lib/server/auth/session.js
# als Konstanten konfiguriert (COOKIE_NAME, DURATION_DAYS).
