# MongoDB — lokal (Docker) oder Atlas
# Lokal:  mongodb://localhost:27017
# Atlas:  mongodb+srv://user:password@cluster.mongodb.net/windroute
MONGODB_URI=mongodb://localhost:27017

GRAPHHOPPER_API_KEY=your_graphhopper_api_key_here

# --- Authentifizierung ---
# Kein separates Session-Secret nötig — Tokens werden kryptografisch
# zufällig mit node:crypto generiert (32 Byte, base64url).
# Cookie-Name und Session-Dauer sind in src/lib/server/auth/session.js
# als Konstanten konfiguriert (COOKIE_NAME, DURATION_DAYS).

# --- Stripe (Pro-Subscription) ---
# Secret Key: Stripe Dashboard → Entwickler → API-Schlüssel
STRIPE_SECRET_KEY=sk_...

# Webhook Secret: lokal via `stripe listen`, Produktion via Stripe Dashboard
STRIPE_WEBHOOK_SECRET=whsec_...

# Price ID: Stripe Dashboard → Produkte → WindRoute Pro → Preise
STRIPE_PRICE_ID=price_...

# Öffentliche URL der App (ohne abschliessenden Slash)
# Lokal: http://localhost:5173  |  Produktion: https://deine-app.netlify.app
APP_URL=http://localhost:5173

